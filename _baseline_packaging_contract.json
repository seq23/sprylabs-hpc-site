{
  "schema_version": "1.0",
  "required_files": [
    "package.json",
    "package-lock.json",
    "REPO_IDENTITY.md",
    "_repo_update_contract.json",
    "_repo_validation_matrix.json",
    "_validation_registry.json",
    "_repo_lifecycle_profile.json",
    "_browser_suite_contract.json",
    "_public_route_manifest.json",
    ".nvmrc",
    "scripts/citation/apply_citation_program.py",
    "scripts/validation/validate_citation_contract.py",
    "scripts/_vendor/VENDOR_MANIFEST.sha256",
    "_critical_browser_route_manifest.json",
    "data/citation/priority_page_acceptance.json",
    "scripts/validation/validate_priority_citation_pages.py",
    "scripts/validation/validate_release_portability.mjs",
    "tests/public-routes.spec.mjs",
    "playwright.config.mjs",
    "data/citation/agent_page_specs.json",
    "data/citation/agent_recommendation_acceptance.json",
    "scripts/validation/validate_agent_recommendations.py",
    ".gitignore",
    "_baseline_packaging_contract.json",
    "scripts/release/prepush_router.mjs",
    "scripts/validation/environment_doctor.mjs",
    "scripts/validation/validate_artifact_source_parity.mjs",
    "scripts/validation/validate_reopened_baseline.mjs",
    "scripts/browser/static_server.mjs",
    "favicon.ico"
  ],
  "excluded_patterns": [
    ".git/",
    "node_modules/",
    ".env",
    ".env.*",
    ".auth/",
    "logs/",
    "artifacts/diagnostics/",
    "test-results/",
    "playwright-report/",
    "__pycache__/",
    "*.pyc"
  ],
  "root_policy": "single_wrapper",
  "artifact_manifest": "_artifact_validation_manifest.json"
}
