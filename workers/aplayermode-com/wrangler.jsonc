// Dedicated Worker for aplayermode.com (NOT the Pages project; Pages deploys
// through its own pipeline). Deploy: npx wrangler deploy --config workers/aplayermode-com/wrangler.jsonc
{
  "name": "aplayermode-com",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "aplayermode.com/*", "zone_name": "aplayermode.com" }],
  "observability": { "enabled": true },
  // Edge cache key (src/index.js): a Worker deploy changes this id, so it never serves pages cached by the previous version.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Pinterest drip measurement (16 Oct 2026): one data point per utm_source=pinterest
  // page view (utm values only; no IP, UA or cookie). $0 within the Workers Paid
  // allowance. Read by scripts/aplayermode/collect_pin_metrics.mjs (SQL API).
  "analytics_engine_datasets": [{ "binding": "PIN_VISITS", "dataset": "aplayermode_pin_visits" }]
}
