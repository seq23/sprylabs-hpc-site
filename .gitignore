# NOTE: coverage/ here is a published site section (coverage/index.html,
# "Coverage | Spry Executive OS"), not test-coverage output. Ignoring it by the
# usual Node convention meant it was never deployed, while sitemap.xml has
# advertised /coverage/ since 2026-06-21 - a 404 in the sitemap the whole time.
__pycache__/
*.pyc
reports/programmatic-candidate-results.json

.validation-cache/

.validation-runtime/

# Generated deployment mirror of site/public. Pages publishes site/public
# directly (wrangler.toml pages_build_output_dir), and build_dist.mjs regenerates
# this on every staged run, so tracking it committed every content change twice.
dist/

# Assembled Cloudflare Pages deploy directory (scripts/assemble_pages_output.js).
.pages-output/

# Build output. Regenerated by `npm run build:all`, which is step 6 of the
# container-prepush profile - ahead of every validator that reads it. The
# deploy workflow takes .build from the Validate Repo artifact, not from git.
.build/
# Runtime build-completion sentinel written by build:all (start/complete).
# Timestamped per run, so tracking it would break build idempotence; it is
# evidence about THIS working tree, read by validate:build-all-integrity.
artifacts/build/

# Agent worktrees. `git worktree add .claude/worktrees/<id>` puts a COMPLETE
# second checkout of this repository inside the working tree. Nothing here is
# ours to commit, and committing it would nest the repo inside itself.
#
# This is a containment measure, not the fix: .gitignore governs git, not the
# directory walkers. build:all's walkers (repair_dual_domain_metadata.js,
# build_navigation_structure.mjs and ~18 others, each with its own hand-written
# skip list) descended into a worktree left here and rewrote 2,295 HTML files
# belonging to another checkout, then wrote that checkout's paths into TRACKED
# data - data/report_fixes/agent_acceptance_manifest.generated.json among them,
# where a real page path was REPLACED by a .claude/worktrees/... one. The
# walkers need '.claude' in their skip lists; see the note in
# scripts/validation/validate_citation_schema_serialization.mjs.
.claude/

# Per-run outputs of the sharded validation gate. The shard plan, the shard
# receipts and the coverage reconciliation are derived from
# _repo_validation_matrix.json on every run and are uploaded as run artifacts;
# committing them would freeze a snapshot of one run's validator set into the
# tree the next run reads.
artifacts/validation/shard-plan.json
artifacts/validation/shard-coverage.json
artifacts/validation/shard-producers.json
artifacts/validation/shards/

# The lastmod derivation receipt, for the same reason and a sharper one.
#
# It is an attestation about ONE run: "this process re-derived the ledger, and
# here is the sha256 of the ledger it left on disk". arm B of
# validate:lastmod-ledger-final reads it to know, as a fact rather than an
# inference, that a derivation happened in the run doing the reading.
#
# commit_and_push_if_changed.sh committed it to main at 93977956f, and from that
# commit every checkout began with a receipt already on disk, already hashing to
# the ledger committed beside it. Spry Content Release run 33767079923 then read
# a receipt written by a run 36 minutes earlier, concluded it had derived the
# ledger itself, compared the untouched committed ledger against a working tree
# its release stages had just rewritten, and reported 1590 of 2231 pages stale.
# Nothing was stale. The lane went red on schedule, every day.
#
# A receipt that survives the run that wrote it is not evidence, it is a claim
# about someone else's work. ledgerDerivationReceipt() also refuses a receipt
# byte-identical to the one at HEAD, which protects every tree that already
# carries one; this keeps new ones from being created.
artifacts/validation/lastmod-derivation-receipt.json

# Content-hash build cache for `npm run build:all` (scripts/build/). Keyed by
# .github/scripts/build_input_hash.sh; safe to delete, it is only ever a speed
# optimization. See docs/runbooks/BUILD_CACHE.md.
.build-cache/
