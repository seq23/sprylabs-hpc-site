{
  "schema_version": "1.5",
  "repo": "seq23/sprylabs-hpc-site",
  "default_mode": "fixture_shadow",
  "sources": [
    {
      "id": "fixture_raw_signals",
      "adapter": "fixture",
      "mode": "fixture",
      "terms_status": "allowed",
      "enabled": true,
      "description": "Deterministic offline fixture demand signals.",
      "producing": false
    },
    {
      "id": "manual_import",
      "adapter": "manual_import",
      "mode": "manual",
      "terms_status": "allowed",
      "enabled": true,
      "description": "Operator-provided source-compliant demand records.",
      "producing": true
    },
    {
      "id": "agent_artifacts",
      "adapter": "agent_artifacts",
      "mode": "export",
      "terms_status": "allowed",
      "enabled": true,
      "description": "Boundary declaration only. data/report_fixes/agent_runs and normalized_agent_runs are hash-protected by prove_agent_separation and already absorbed by scripts/agent_intake; this source never emits demand records.",
      "producing": false
    },
    {
      "id": "forums_rss",
      "adapter": "forums_rss",
      "mode": "rss",
      "terms_status": "requires_review",
      "enabled": false,
      "description": "Public RSS/forum feeds only after terms review.",
      "producing": true
    },
    {
      "id": "reddit",
      "adapter": "reddit",
      "mode": "api",
      "terms_status": "requires_credentials",
      "enabled": false,
      "description": "Reddit API or manual exports only; no unauthorized scraping.",
      "producing": true
    },
    {
      "id": "bluesky",
      "adapter": "bluesky",
      "mode": "firehose",
      "terms_status": "requires_review",
      "enabled": false,
      "description": "ATProto/firehose only after source authority review.",
      "producing": true
    },
    {
      "id": "x",
      "adapter": "x",
      "mode": "api",
      "terms_status": "requires_credentials",
      "enabled": false,
      "description": "X API filtered stream only with credentials and terms authority.",
      "producing": true
    },
    {
      "id": "youtube",
      "adapter": "youtube",
      "mode": "api",
      "terms_status": "requires_credentials",
      "enabled": false,
      "description": "YouTube API/search only with credentials and quota authority.",
      "producing": true
    },
    {
      "id": "search_console",
      "adapter": "search_console",
      "mode": "export",
      "terms_status": "requires_credentials",
      "enabled": false,
      "description": "Owned GSC export/API only.",
      "producing": true
    }
  ],
  "producing_contract": "A source with producing=true and enabled=true must be able to emit demand records. validate:signal-source-producers proves each one against its adapter and fails on any that cannot."
}
