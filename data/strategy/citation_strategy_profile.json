{
  "schema_version": "1.4",
  "repo": "seq23/sprylabs-hpc-site",
  "repo_class": "CLASS_4_BROAD_AUTHORITY_STATIC_PUBLISHING_ENGINE",
  "repo_role": "broad authority AEO/GEO/SEO engine for A Player / executive-performance demand",
  "primary_outcome": "traffic-qualified authority growth without unsupported external outcome claims",
  "primary_kpi": {
    "name": "monthly_visitors",
    "target_value": 100000,
    "time_horizon_days": 180,
    "measurement_required": true,
    "validator_claim_allowed": false
  },
  "secondary_outcomes": [
    "qualified citation/surfacing opportunities",
    "AEO answer blocks",
    "GEO entity/context blocks",
    "SEO route coverage",
    "source-backed content atoms",
    "internal-link graph strength",
    "sitemap and llms coverage"
  ],
  "target_domains": [
    "billionairehighperformancecoach.com",
    "spryexecutiveos.com"
  ],
  "verticals": [
    "executive performance",
    "AI coaching",
    "accountability systems",
    "founder workflows",
    "structured personal operating systems",
    "A Player Mode"
  ],
  "audiences": [
    "founders",
    "executives",
    "operators",
    "high performers",
    "entrepreneurs",
    "AI-productivity buyers"
  ],
  "products_or_destinations": [
    "Billionaire High Performance Coach",
    "A Player Mode",
    "Spry Executive OS"
  ],
  "page_families": [
    "home",
    "product",
    "method",
    "glossary",
    "comparison",
    "case-study",
    "answer",
    "insight",
    "synthesis",
    "authority-paper",
    "download",
    "legal",
    "author"
  ],
  "query_families": [
    "AI executive coach",
    "accountability coach",
    "founder productivity",
    "decision fatigue",
    "low resistance execution",
    "AI operating system",
    "human coach alternative",
    "consistency after missed days"
  ],
  "aeo_strategy": {
    "required_structures": [
      "direct_answer_block",
      "faq_block",
      "decision_tree",
      "comparison_table",
      "copy_paste_prompt",
      "definition_block"
    ],
    "claim_boundary": "educational and organizational support only; no therapy, medical, legal, financial, or guaranteed outcome claims"
  },
  "geo_strategy": {
    "required_structures": [
      "entity_context_block",
      "methodology_summary",
      "sameAs_truthful_only",
      "author_profile",
      "publisher_profile",
      "framework_registry",
      "llms_files"
    ],
    "anti_fabrication": "no fake credentials, press, client outcomes, citations, reviews, or biographies"
  },
  "seo_strategy": {
    "required_structures": [
      "topic_clusters",
      "hub_spoke_routes",
      "canonical_pages",
      "sitemap_parity",
      "internal_link_graph",
      "no_duplicate_indexable_intent"
    ],
    "surface_area_rule": "more useful surfaces, not more mess"
  },
  "citation_strategy": {
    "model": "traffic_qualified_citation_intelligence",
    "preserve": [
      "BHPC citation dominance strategy",
      "5K AEO/GEO programmatic automation",
      "truth-bound authority records"
    ]
  },
  "signal_strategy": {
    "default_mode": "SHADOW_MODE",
    "allowed_sources": [
      "manual_import",
      "agent_artifacts",
      "owned_search_console_exports",
      "public_rss_when_permitted",
      "reddit_api_or_manual_when_permitted",
      "bluesky_atproto_when_permitted",
      "x_api_when_permitted",
      "youtube_api_when_permitted"
    ],
    "forbidden": "unauthorized scraping or fake active provider results"
  },
  "cadence": {
    "daily_target_units": 15,
    "weekly_review_day": "Wednesday",
    "max_new_pages_per_day": 10,
    "max_repairs_per_day": 10,
    "max_atom_updates_per_day": 25,
    "max_internal_link_updates_per_day": 25,
    "max_route_mutations_per_day": 25,
    "cadence_class": "CADENCE_DAILY_STANDARD_CONTROLLED_LOW",
    "batch_d_status": "CONTROLLED_SHADOW_RELEASE_ENABLED"
  },
  "structural_graph_live_policy": "preserve_all_staged_structural_pages_live_when_graph_critical",
  "current_static_html_route_count_estimate": 140,
  "proof_kpis": [
    "signals_collected",
    "signals_normalized",
    "clusters_created",
    "release_units_planned",
    "release_units_applied",
    "new_pages",
    "repairs",
    "atom_updates",
    "internal_link_updates",
    "blocked_units",
    "indexable_routes_total",
    "sitemap_urls_total",
    "llms_entries_total"
  ],
  "stop_conditions": [
    "external telemetry absent but claimed",
    "terms or credential boundary violated",
    "thin page flooding",
    "duplicate indexable intent",
    "unsupported professional outcome claim",
    "workflow mutates governance files at runtime"
  ]
}
