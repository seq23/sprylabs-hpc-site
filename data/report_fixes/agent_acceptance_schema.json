{
  "schema_version": "1.1",
  "name": "BHPC agent semantic acceptance manifest",
  "required_entry_fields": [
    "id",
    "record_id",
    "run_date",
    "scope",
    "query",
    "source_fix_instruction",
    "implementation_path",
    "route_status",
    "page_family",
    "acceptance_status",
    "required_heading",
    "required_block_types",
    "required_strings"
  ],
  "allowed_acceptance_statuses": [
    "REQUIRED",
    "BLOCKED",
    "NO_ACTION"
  ],
  "allowed_page_families": [
    "answer_page",
    "authority_insight",
    "bhpc_insight",
    "cluster_page",
    "comparison_page",
    "fallback_gap_fill",
    "intended_winner_repair",
    "no_action"
  ],
  "allowed_block_types": [
    "acceptance_strings",
    "agent_directive",
    "checklist",
    "comparison_table",
    "cta_callout",
    "definition_callout",
    "direct_answer",
    "gap_separation",
    "internal_link_set",
    "prompt_template",
    "protocol",
    "recommendation_summary",
    "source_block",
    "trust_block"
  ],
  "optional_entry_fields": [
    "seo_execution",
    "seo_execution_hash",
    "page_decision",
    "recommended_page_type",
    "required_internal_links",
    "schema_action",
    "acceptance_checks"
  ]
}
