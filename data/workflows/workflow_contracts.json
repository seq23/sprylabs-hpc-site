{
  "schema_version": "1.1",
  "remote_advance_policy": "reset-regenerate-validate-recommit",
  "governed_workflows": [
    {
      "id": "content-authority",
      "name": "Content Authority Pipeline",
      "workflow_file": ".github/workflows/content-authority-pipeline.yml",
      "lane": "authority",
      "workflow_command": "npm run workflow:content-authority",
      "workflow_argv": [
        "npm",
        "run",
        "workflow:content-authority"
      ],
      "commit_message": "Run content authority pipeline",
      "schedule_cron": "17 14 * * *",
      "manual_dispatch": true,
      "monitor_max_age_hours": 36,
      "remote_advance_strategy": "reset-regenerate-validate-recommit",
      "lineage_inputs": [
        "config/social_ingestion_policy.json",
        "config/social_sources.json",
        "data/content/page_admission_registry.json",
        "data/content/programmatic_lane_contracts.json",
        "data/citation/**",
        "scripts/authority/**",
        "scripts/community/**",
        "scripts/synthesis/**",
        "templates/**",
        "data/report_fixes/agent_runs/**",
        "data/report_fixes/normalized_agent_runs/**",
        "data/social/runs/**"
      ],
      "lineage_outputs": [
        "admin.html",
        "comparisons/**",
        "data/**",
        "insights/**",
        "releases/**",
        "sitemap*.xml",
        "sitemaps/**",
        "synthesis-*.html",
        "data/report_fixes/normalized_agent_runs/**",
        "data/social/runs/**",
        "artifacts/validation/agent-exact-implementation*.json",
        "data/citation/agent_page_specs.generated.json",
        "data/citation/agent_repair_specs.generated.json"
      ],
      "required_outputs": [
        "admin.html",
        "data/content/page_admission_registry.json",
        "data/programmatic/latest_run_summary.json"
      ],
      "allowed_change_patterns": [
        "*.html",
        "_ops/daily-insights/**",
        "answers/**",
        "clusters/**",
        "comparisons/**",
        "content/**",
        "coverage.json",
        "data/**",
        "feed.json",
        "feed.xml",
        "insights/**",
        "llms*.txt",
        "models/**",
        "pillars/**",
        "releases/**",
        "sitemap*.xml",
        "sitemaps/**",
        "synthesis-*.html"
      ],
      "forbidden_change_patterns": [
        ".github/**",
        "config/**",
        "docs/**",
        "package.json",
        "package-lock.json",
        "playwright.config.mjs",
        "scripts/**",
        "tests/**",
        "_repo_*.json",
        "_validation_registry.json",
        "_browser_suite_contract.json"
      ],
      "artifact_receipt_paths": [
        "data/report_fixes/agent_runs/**/agent_run_manifest.json"
      ],
      "artifact_trigger_policy": "Manifest-only trigger. CSV and HTML may land before manifest, but the workflow only starts when the manifest declares the bundle ready.",
      "artifact_contract": "BHPC CSV + HTML + manifest under data/report_fixes/agent_runs/YYYY-MM-DD/bhpc/",
      "fallback_behavior": "If no ready artifact exists, or if artifact volume is insufficient, workflow:content-authority continues the existing content pipeline unchanged."
    },
