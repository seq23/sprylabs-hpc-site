  "component_command_policy": {
    "status": "private_components_allowed",
    "rule": "component scripts may remain in package.json but scheduled workflows and human operator docs should target canonical workflow lanes."
  },
  "trace_only_policy": {
    "status": "enabled",
    "rule": "Trace-only mode writes deterministic fixture traces for every governed workflow without executing component commands or mutating operational reports."
  }
