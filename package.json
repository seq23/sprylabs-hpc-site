{
  "name": "sprylabs-hpc-site",
  "private": true,
  "version": "0.0.0-snapshot",
  "scripts": {
    "build:pages-output": "node scripts/assemble_pages_output.js",
    "search:targets": "node scripts/search_intelligence/build_target_query_set.mjs",
    "search:truth": "node scripts/search_intelligence/ingest_gsc_truth.mjs",
    "sitemap:lastmod:content": "node scripts/sitemap_content_lastmod.mjs && node scripts/aplayermode_sitemap_lastmod.mjs",
    "check:aplayermode-live": "node scripts/diagnostics/check_aplayermode_live.mjs",
    "validate:aplayermode-pinterest": "node scripts/validators/validate_aplayermode_pinterest.mjs",
    "validate:aplayermode-pin-drip": "node --test tests/aplayermode/pinqueue.test.mjs",
    "report:weekly-outcome": "node scripts/reports/build_weekly_outcome_report.mjs",
    "self-test:weekly-outcome-report": "node scripts/reports/self_test_weekly_outcome_report.mjs",
    "build:route-owner-table": "node scripts/build/build_route_owner_table.mjs",
    "check:ai-measurement": "node scripts/diagnostics/check_ai_measurement.mjs",
    "self-test:ai-measurement": "node scripts/diagnostics/check_ai_measurement.mjs --self-test",
    "typecheck": "git ls-files -z -- \"*.js\" \"*.mjs\" \"*.cjs\" \":!:assets/**\" \":!:public/**\" \":!:fixtures/**\" | xargs -0 -P8 -n1 node --check",
    "test": "node --test tests/canonical_host.test.mjs tests/edge_cache.test.mjs tests/free_llm_router.test.mjs tests/homepage_trust_links.test.mjs tests/host_consolidation.test.mjs tests/route_owner_host.test.mjs tests/search_loop_replay.test.mjs tests/spry_rescue.test.mjs tests/search_loop_blitz.test.mjs tests/buy_link_tags.test.mjs tests/aplayermode/pinqueue.test.mjs tests/aplayermode/companion_route.test.mjs && bash .github/scripts/test_commit_and_push_if_changed.sh",
    "validate": "node scripts/validators/run_safety_checks.mjs",
    "watch:entity-backlinks": "node scripts/entity/entity_backlink_watch.mjs",
    "self-test:entity-backlink-watch": "node scripts/entity/self_test_entity_backlink_watch.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  }
}
